# Copy to .env and replace placeholders. Never commit .env.

# Database (required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bookly_db

# JWT (required)
JWT_SECRET=change-me-generate-with-secrets-token-urlsafe
JWT_ALGORITHM=HS256

# Redis
REDIS_URL=redis://localhost:6379/0

# Mail (optional for local dev without email)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Bookly
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# App
DOMAIN=localhost:8000
APP_SCHEME=http
ADMIN_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
